# Copy to .env (git-ignored) and fill in. Never commit real values.

# Web app (ASP.NET Core maps "__" to ":" in configuration keys)
ConnectionStrings__DefaultConnection=Server=<host>,1433;Database=<db>;User Id=<app_user>;Password=<password>;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=False;

# Trader service
COPYTRADER_DB_CONNECTION_STRING=Server=<host>,1433;Database=<db>;User Id=<app_user>;Password=<password>;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=False;
