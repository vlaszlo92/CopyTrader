# Local development only (docker compose up). Fake credentials for a throwaway container.
# Local container uses a self-signed certificate, therefore TrustServerCertificate=True is accepted here and only here.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=CopyTrader;User Id=copytrader_app;Password=CopyTraderApp_Local1!;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True;
COPYTRADER_DB_CONNECTION_STRING=Server=localhost,1433;Database=CopyTrader;User Id=copytrader_app;Password=CopyTraderApp_Local1!;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True;
