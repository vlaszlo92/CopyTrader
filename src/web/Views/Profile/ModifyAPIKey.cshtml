@model CopyTrader.Web.Models.UserAPIKeyViewModel
@{
    var message = TempData["message"] ?? string.Empty;
}
<head>
    <link href="~/css/profile.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.materialdesignicons.com/5.4.55/css/materialdesignicons.min.css">

</head>

<script type="text/javascript">
    var message = '@message';
    if (message)
        alert(message);
</script>

<div class="main-panel text-center">
    <div class="container">
        <div class="row">
            <div class="col-md-6 grid-margin stretch-card mx-auto">
                <div class="card">
                    <div class="card-body">
                        <p class="card-title font-weight-bold">API Kulcs módosítása</p>
                        <hr>
                        <form asp-action="ModifyAPIKey">
                            <div class="form-group">
                                <label asp-for="Key" class="control-label">API Kulcs</label>
                                <input asp-for="Key" class="form-control" />
                                <span asp-validation-for="Key" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Secure" class="control-label">Biztonsági Kulcs</label>
                                <input asp-for="Secure" class="form-control" />
                                <span asp-validation-for="Secure" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <input type="submit" value="Módosítás" class="btn btn-primary" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>